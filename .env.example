# traintracker configuration. Copy to .env (git-ignored) and fill in.
# Django reads .env from the project folder on start-up; real environment
# variables take precedence. See README "Accounts you need".

# --- Django (Titan). Local development needs none of these; on Render, titan's env groups set them.
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=          (required with DJANGO_DEBUG=0)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=
# SITE_URL=http://localhost:8000
# RATE_LIMIT_PROXY_COUNT=     (0 locally, 1 behind Render's proxy)
# Sign-in email (docs/accounts.md). The console in development. Resend takes SMTP too:
# EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=<the API key>.
# EMAIL_BACKEND=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Traintrackr <noreply@traintrackr.live>
# WEBAUTHN_RP_ID=             (passkeys; the host name of SITE_URL by default)
# FIVEBAR_DOMAIN=             (visitor counts; off when empty)

# --- Demo mode: generated example data, no accounts needed. Remove once keys are set.
# TRAINTRACKER_DEMO=1

# --- Postgres database for the timetable (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
# TIMETABLE_SCHEMA=timetable

# --- 1. Rail Data Marketplace: Live Departure Board (required for live times)
# Product > Specification tab > "Consumer key" (not the secret).
DARWIN_API_KEY=
# Only if your Specification tab shows a different base URL:
# DARWIN_DEPARTURES_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120

# --- 2. Network Rail Open Data: SCHEDULE feed (required for timetables and planning)
NR_USERNAME=
NR_PASSWORD=
# Only if the portal gives a different link for the full daily JSON extract:
# NR_SCHEDULE_URL=https://publicdatafeeds.networkrail.co.uk/ntrod/CifFileAuthenticate?type=CIF_ALL_FULL_DAILY&day=toc-full

# --- 3. Optional: Rail Data Marketplace Service Details (defaults to DARWIN_API_KEY)
# DARWIN_SERVICE_API_KEY=
# DARWIN_SERVICE_URL=https://api1.raildata.org.uk/1010-service-details1_2/LDBWS/api/20220120

# --- 4. Optional: Rail Data Marketplace Live Arrival Board
# DARWIN_ARRIVALS_API_KEY=
# DARWIN_ARRIVALS_URL=

# --- The MCP endpoint
# RATE_LIMIT_PER_MINUTE=30    (tool calls per account; 0 = no limit)
# RATE_LIMIT_BURST=10
# OPENAI_APPS_CHALLENGE=       (token from OpenAI's plugin portal, for its domain check)

# --- Tuning
# USAGE_SCHEMA=traintracker_usage   (where the count of Darwin requests is kept)
# DARWIN_DAILY_LIMIT=170000         (requests to Darwin in one day; 0 = no limit)
# TRAINTRACKER_DATA_DIR=~/.traintracker
# TIMETABLE_AUTO_REFRESH=1
# TIMETABLE_MAX_AGE_HOURS=26
# MIN_INTERCHANGE_MINUTES=5
# TRAINLINE_LIVE_URL=https://www.thetrainline.com/live   (base of the link to a train's page on Trainline)
# HTTP_TIMEOUT_SECONDS=15
