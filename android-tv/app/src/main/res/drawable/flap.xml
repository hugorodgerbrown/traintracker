<?xml version="1.0" encoding="utf-8"?>
<!-- A flap: the board's cell, with the seam across its middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/flap" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:gravity="center_vertical" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/flap_seam" />
        </shape>
    </item>
</layer-list>
