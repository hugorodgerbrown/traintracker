#!/usr/bin/env python3
"""Fail on any high or critical npm advisory, except the few listed below.

``tox -e audit`` runs it in place of ``npm audit --audit-level=high``, which
has no way to set one advisory aside. Reads ``npm audit --json`` on stdin when
given ``-``, otherwise runs it:

    python bin/npm-audit
    npm audit --json | python bin/npm-audit -

An exception names one advisory by its GHSA id, says why it can't reach
production, and the date it was added. Remove it as soon as a fixed release
is out (docs/security.md, "npm advisories").
"""

import json
import logging
import subprocess
import sys

logger = logging.getLogger(__name__)

FAILING = ("high", "critical")

# GHSA id: why it is set aside, and since when.
EXCEPTIONS = {
    "GHSA-fc5q-39xc-vjpf": (
        "picomatch ReDoS, reached only through vitest (test tooling; the app "
        "ships no npm code). No fixed release exists. Added 18 Nov 2026."
    ),
}


def advisories(report: dict) -> dict[str, tuple[str, str]]:
    """Every advisory in the report: GHSA id -> (package, severity)."""
    found: dict[str, tuple[str, str]] = {}
    for package in report.get("vulnerabilities", {}).values():
        for via in package.get("via", []):
            if isinstance(via, dict):
                ghsa = str(via.get("url", "")).rstrip("/").rsplit("/", 1)[-1]
                found[ghsa] = (str(via.get("name", "?")), str(via.get("severity", "")))
    return found


def failures(report: dict) -> list[str]:
    """The high or critical advisories that are not excepted, as lines to print."""
    return [
        f"{severity}: {package} https://github.com/advisories/{ghsa}"
        for ghsa, (package, severity) in sorted(advisories(report).items())
        if severity in FAILING and ghsa not in EXCEPTIONS
    ]


def main(argv: list[str]) -> int:
    """Audit, print what fails, and exit non-zero if anything does."""
    if argv[1:] == ["-"]:
        text = sys.stdin.read()
    else:
        text = subprocess.run(
            ["npm", "audit", "--json"], capture_output=True, text=True, check=False
        ).stdout
    report = json.loads(text or "{}")
    for ghsa in sorted(set(advisories(report)) & set(EXCEPTIONS)):
        sys.stdout.write(f"excepted: {ghsa} ({EXCEPTIONS[ghsa]})\n")
    problems = failures(report)
    for line in problems:
        sys.stdout.write(f"{line}\n")
    if problems:
        sys.stdout.write(f"{len(problems)} high or critical npm advisory(ies).\n")
        return 1
    sys.stdout.write("No high or critical npm advisories outside the exceptions.\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
